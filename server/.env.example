# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas M0 for Dev)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medikart_dev?retryWrites=true&w=majority

# Caching and Rate Limiting Configuration
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRES_IN=24h

# SMTP Email Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@medikart.pk

# Habib Metro Payment Gateway
HABIB_METRO_API_URL=https://sandbox.habibmetro.com
HABIB_METRO_MERCHANT_ID=mock_merchant_id
HABIB_METRO_SECURE_KEY=mock_secure_key

# Groq LLM API Settings
GROQ_API_KEY=mock_groq_api_key
